# Multiplayer for the runner game (Supabase Realtime: broadcast + presence, no tables needed).
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon/publishable key is public by design; it ends up in the browser bundle either way.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
